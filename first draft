<?php
session_start();

// remp!!!
$_SESSION['seller_id'] = 1; 


if (!isset($_SESSION['seller_id'])) {
    header("Location: login.html");
    exit();
}


if ($_SERVER["REQUEST_METHOD"] == "POST") {
 
    $conn = new mysqli('127.0.0.1', 'root', '', 'car_sale_db');

    if ($conn->connect_error) {
        die("Connection failed: " . $conn->connect_error);
    }

  
    $seller_id = $_SESSION['seller_id'];
    $colour = $_POST['colour'];
    $model = $_POST['model'];
    $year = $_POST['year'];
    $location = $_POST['location'];
    $price = $_POST['price'];

   
    $stmt = $conn->prepare("INSERT INTO cars (seller_id, colour, model, year, location, price) VALUES (?, ?, ?, ?, ?, ?)");
    

    $stmt->bind_param("ississ", $seller_id, $colour, $model, $year, $location, $price);
    
    if ($stmt->execute()) {
    
        echo "<script>alert('Car posted successfully!');</script>";
    } else {
        echo "<script>alert('Error: Could not save data.');</script>";
    }
    
    $stmt->close();
    $conn->close();
}
